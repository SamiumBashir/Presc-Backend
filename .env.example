PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/prescription_db
JWT_SECRET=doctor_prescription_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=cookie_secret_prescription_2026
CORS_ORIGIN=http://localhost:5173,https://doc-presc.vercel.app
FRONTEND_URL=https://doc-presc.vercel.app

# Email Delivery Configuration
# Provider selection: 'smtp' | 'resend' | 'brevo' | 'auto'
EMAIL_PROVIDER=smtp
ENABLE_EMAIL_FALLBACK=false

# Option A: Nodemailer / Gmail SMTP Configuration (Recommended free solution without purchasing domain)
# For Gmail SMTP: Turn ON 2-Step Verification on Google Account, then generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=Doc Presc <your_email@gmail.com>

# Option B: Optional Third-Party APIs (Not required when using Gmail SMTP)
RESEND_API_KEY=
BREVO_API_KEY=

# Password Reset Security & OTP Configuration
OTP_EXPIRES_IN=600
OTP_RESEND_COOLDOWN=60
OTP_PEPPER=docpresc_otp_security_pepper_2026

# Optional: Redis Cache & Temporary State Store
REDIS_URL=

# Cloudinary Configuration for Image/Signature Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
