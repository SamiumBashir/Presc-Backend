# ==============================================================================
# DOCPRESC BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Compatible with both Local Development and Vercel Serverless Deployment
# ==============================================================================

# Core Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Required: MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/doctor_prescription?retryWrites=true&w=majority

# Authentication & Security Secrets
JWT_SECRET=doctor_prescription_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=cookie_secret_prescription_2026

# Cross-Origin Resource Sharing (CORS) & Client URLs
CORS_ORIGIN=https://doc-presc.vercel.app,http://localhost:5173
FRONTEND_URL=https://doc-presc.vercel.app

# ==============================================================================
# Transactional Email Delivery (OTP Password Reset & Welcome Email)
# Provider Selection: 'brevo' | 'resend' | 'smtp' | 'auto'
# NOTE for Vercel Serverless: HTTPS APIs ('brevo' or 'resend') are recommended
# because cloud serverless environments avoid outbound SMTP port limitations.
# ==============================================================================
EMAIL_PROVIDER=brevo
ENABLE_EMAIL_FALLBACK=false
EMAIL_FROM=Doc Presc <your-verified-email@gmail.com>

# Option 1: Brevo (Sendinblue) HTTPS API (Port 443 - Recommended on Vercel)
# 300 free emails/day. Get free API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxx

# Option 2: Resend HTTPS API (Port 443)
# Get free API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx

# Option 3: Nodemailer / Gmail SMTP Configuration
# Uses Google App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password

# OTP Security Parameters
OTP_EXPIRES_IN=600
OTP_RESEND_COOLDOWN=60
OTP_PEPPER=docpresc_otp_security_pepper_2026

# Cloudinary Storage for Doctor Signatures and Prescription Logos (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Redis Cache Store (Optional - defaults to in-memory/MongoDB)
REDIS_URL=
