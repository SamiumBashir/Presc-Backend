PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/prescription_db
JWT_SECRET=doctor_prescription_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=cookie_secret_prescription_2026
CORS_ORIGIN=http://localhost:5173,https://doc-presc.vercel.app
FRONTEND_URL=https://doc-presc.vercel.app

# Email Delivery Configuration
# Option A: Nodemailer / SMTP Configuration (e.g. Gmail SMTP)
# Note: Render Free Tier blocks outbound SMTP ports 25, 465, and 587.
# For Gmail SMTP, enable 2-Step Verification and generate a 16-character App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=Doc Presc <your_email@gmail.com>

# Option B: Resend or Brevo API (Recommended for Cloud Hosting / Render Free Tier via HTTPS 443)
# Setting RESEND_API_KEY automatically uses Resend via HTTPS (bypasses SMTP port blocks).
# If EMAIL_FROM uses an unverified webmail domain (e.g. @gmail.com), Resend safely falls back to onboarding@resend.dev.
RESEND_API_KEY=
BREVO_API_KEY=

# Password Reset Security & OTP Configuration
OTP_EXPIRES_IN=600
OTP_RESEND_COOLDOWN=60
OTP_PEPPER=docpresc_otp_security_pepper_2026

# Optional: Redis Cache & Temporary State Store
REDIS_URL=

# Cloudinary Configuration for Image/Signature Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
