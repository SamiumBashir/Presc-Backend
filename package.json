{
  "name": "prescription-backend",
  "version": "1.0.0",
  "description": "Doctor Digital Prescription Management System - API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"Backend lint: OK\" && exit 0",
    "postinstall": "npm run build",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "seed": "tsx src/seeds/seed.ts",
    "test": "tsx src/tests/run-tests.ts",
    "test:email": "tsx src/tests/test-email-delivery-suite.ts",
    "test:otp": "tsx src/tests/test-otp-flow.ts",
    "test:regression": "tsx src/tests/regression-server-connection.ts",
    "test:e2e": "tsx src/tests/e2e-verification.ts",
    "test:all": "tsx src/tests/run-tests.ts && tsx src/tests/test-email-delivery-suite.ts && tsx src/tests/test-otp-flow.ts && tsx src/tests/regression-server-connection.ts && tsx src/tests/e2e-verification.ts",
    "scrape:medex": "tsx scripts/medex/scrape-medex.ts",
    "clean:medex": "tsx scripts/medex/clean-medex.ts",
    "import:medex": "tsx scripts/medex/import-medex.ts",
    "test:medex": "tsx scripts/medex/scrape-medex.ts --sample",
    "pipeline:medex": "tsx scripts/medex/scrape-medex.ts && tsx scripts/medex/clean-medex.ts && tsx scripts/medex/import-medex.ts",
    "scrape:herbal": "tsx scripts/medex/scrape-medex-herbal.ts",
    "clean:herbal": "tsx scripts/medex/clean-medex-herbal.ts",
    "import:herbal": "tsx scripts/medex/import-medex-herbal.ts",
    "pipeline:herbal": "tsx scripts/medex/scrape-medex-herbal.ts && tsx scripts/medex/clean-medex-herbal.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.14",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^9.3.0",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.0",
    "resend": "^6.32.1",
    "typescript": "^5.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.16.5"
  }
}
